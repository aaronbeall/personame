generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Authentication
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  personas      Persona[]
  results       QuizResult[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Persona (Quiz)
model Persona {
  id          String            @id @default(cuid())
  title       String
  description String?
  slug        String            @unique
  emoji       String?
  color       String? // Ordered comma-separated lowercase hex colors (#rrggbb[,#rrggbb...])
  style       String?
  icon        String?
  status      PersonaStatus     @default(DRAFT)
  visibility  PersonaVisibility @default(PRIVATE)

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  dimensions    Dimension[]
  archetypes Archetype[]
  pages      QuizPage[]
  results    QuizResult[]

  views       Int @default(0)
  completions Int @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([creatorId])
  @@index([creatorId, updatedAt, id])
  @@index([status, visibility, publishedAt, id])
  @@index([status])
  @@index([visibility])
  @@index([publishedAt])
}

enum PersonaStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum PersonaVisibility {
  PRIVATE
  PUBLIC
}

// Display metadata only. Scores and targets remain normalized to 0–100.
enum DimensionDisplayScale {
  PERCENT_ASCENDING
  PERCENT_DESCENDING
  BIPOLAR
}

// Dimensions (e.g., Openness, Conscientiousness)
model Dimension {
  id          String  @id @default(cuid())
  name        String
  description String?
  minEmoji    String?
  maxEmoji    String?
  displayScale DimensionDisplayScale @default(PERCENT_ASCENDING)
  minLabel    String? // Label for minimum value (e.g., "Introverted")
  maxLabel    String? // Label for maximum value (e.g., "Extroverted")
  order       Int     @default(0)
  emoji       String?
  color       String? // Ordered comma-separated lowercase hex colors (#rrggbb[,#rrggbb...])
  style       String?
  icon        String?

  personaId String
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  archetypeDimensions ArchetypeDimension[]
  answerWeights    AnswerWeight[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personaId])
}

// Archetypes (personality types)
model Archetype {
  id          String  @id @default(cuid())
  name        String
  description String?
  emoji       String?
  color       String? // Ordered comma-separated lowercase hex colors (#rrggbb[,#rrggbb...])
  imageUrl    String?
  order       Int     @default(0)
  style       String?
  icon        String?

  personaId String
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  dimensions ArchetypeDimension[]
  results QuizResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personaId])
}

// Archetype target values for each dimension
model ArchetypeDimension {
  id          String @id @default(cuid())
  targetValue Float // Target value for this dimension (0-100)
  relevance   Float  @default(1.0) // How important this dimension is (0-1)

  archetypeId String
  archetype   Archetype @relation(fields: [archetypeId], references: [id], onDelete: Cascade)

  dimensionId String
  dimension   Dimension @relation(fields: [dimensionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([archetypeId, dimensionId])
  @@index([archetypeId])
  @@index([dimensionId])
}

// Quiz Pages
model QuizPage {
  id          String  @id @default(cuid())
  title       String?
  description String?
  order       Int     @default(0)
  hidden      Boolean @default(false)
  emoji       String?
  color       String? // Ordered comma-separated lowercase hex colors (#rrggbb[,#rrggbb...])
  style       String?
  icon        String?

  personaId String
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  questions Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personaId])
}

// Questions
model Question {
  id       String       @id @default(cuid())
  text     String
  type     QuestionType
  order    Int          @default(0)
  required Boolean      @default(true)
  dimensionInfluences Json @default("{}") // Relative question influence keyed by dimension ID; omitted = 1
  emoji    String?
  color    String?
  style    String?
  icon     String?

  pageId String
  page   QuizPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  answers Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
}

enum QuestionType {
  MULTIPLE_CHOICE
  SLIDER
  SCALE
}

// Answer options for questions
model Answer {
  id    String  @id @default(cuid())
  text  String
  order Int     @default(0)
  emoji String?
  color String?
  style String?
  icon  String?

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  weights     AnswerWeight[]
  userAnswers UserAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
}

// How each answer affects dimensions
model AnswerWeight {
  id    String @id @default(cuid())
  value Float // Suggested position on a dimension (0 to 100); absent = unrelated

  answerId String
  answer   Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  dimensionId String
  dimension   Dimension @relation(fields: [dimensionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([answerId, dimensionId])
  @@index([answerId])
  @@index([dimensionId])
}

// Quiz Results
model QuizResult {
  id String @id @default(cuid())

  personaId String
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  archetypeId String?
  archetype   Archetype? @relation(fields: [archetypeId], references: [id], onDelete: SetNull)
  snapshot Json?
  submissionKey String? @unique

  answers      UserAnswer[]
  dimensionScores DimensionScore[]

  completedAt DateTime @default(now())

  @@index([personaId])
  @@index([userId])
  @@index([archetypeId])
  @@index([completedAt])
  @@index([userId, personaId, completedAt(sort: Desc), id(sort: Desc)])
}

// User's answer to a question
model UserAnswer {
  id String @id @default(cuid())

  resultId String
  result   QuizResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  answerId String?
  answer   Answer? @relation(fields: [answerId], references: [id], onDelete: SetNull)

  value Float? // For slider/scale questions

  createdAt DateTime @default(now())

  @@index([resultId])
  @@index([answerId])
}

// Final dimension scores for a result
model DimensionScore {
  id    String @id @default(cuid())
  score Float // Final calculated score (0-100)

  resultId String
  result   QuizResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  dimensionName String // Stored for historical data

  createdAt DateTime @default(now())

  @@index([resultId])
}
