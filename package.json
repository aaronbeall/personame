{
  "name": "personame",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:init": "prisma migrate dev --name init",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:update": "prisma db push && prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "./setup.sh",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/*.unit.test.ts tests/scoring.test.ts",
    "test:coverage": "node --import tsx --experimental-test-coverage --test-coverage-include=\"lib/quiz-*.ts\" --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=90 --test tests/*.unit.test.ts tests/scoring.test.ts",
    "test:e2e": "npm run test:e2e:prepare && playwright test",
    "test:e2e:ui": "npm run test:e2e:prepare && playwright test --ui",
    "test:e2e:headed": "npm run test:e2e:prepare && playwright test --headed",
    "test:e2e:debug": "npm run test:e2e:prepare && playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:trace": "playwright show-trace",
    "catalog:validate": "node --import tsx scripts/validate-catalog.ts",
    "catalog:seed": "node --import tsx scripts/seed-catalog.ts",
    "test:e2e:prepare": "PERSONAME_E2E=1 next build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "full-emoji-list": "^17.0.3",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "next-auth": "^4.24.13",
    "postcss": "^8.5.6",
    "prisma": "^6.19.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.70.0",
    "react-icons": "^5.5.0",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.7.0",
    "typescript": "^5"
  }
}
